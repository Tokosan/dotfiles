{{- if .laptop -}}
hl.monitor({
    output = "eDP-1",
    mode = "preferred",
    position = "0x0",
    scale = "auto",
})
{{- else -}}
hl.monitor({
    output = "DP-1",
    mode = "1920x1080@165.00Hz",
    position = "0x0",
    scale = "auto",
})

hl.monitor({
    output = "HDMI-A-1",
    mode = "3840x2160@60.00Hz",
    position = "1920x0",
    scale = "2",
})
{{- end }}

-- Cualquier otra pantalla (p. ej. un monitor enchufado al laptop).
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})
