#!/usr/bin/env bash
# Controla fondos de tipo "scene" de Wallpaper Engine, por monitor.
#
#   wallpaper-scene start [id]  Lanza una scene (aleatoria si no se indica id)
#   wallpaper-scene stop        La detiene y restaura el fondo estático
#   wallpaper-scene toggle      Alterna entre scene y estático
#   wallpaper-scene next        Salta a otra scene al azar
#   wallpaper-scene list        Lista las scenes disponibles con su título
#
#   -m, --monitor <nombre|all|focused>  Sobre qué pantalla actuar (por defecto: all)
set -euo pipefail

WORKSHOP="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
ASSETS="$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets"
FPS=30
MONITOR="all"

# Los flags pueden ir antes o después del subcomando.
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m | --monitor)
            MONITOR="${2:?--monitor necesita un nombre}"
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
set -- "${args[@]+"${args[@]}"}"

monitors() {
    case "$MONITOR" in
        all)
            hyprctl monitors -j 2>/dev/null |
                python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin)]' 2>/dev/null
            ;;
        focused)
            # Se resuelve aquí y no en la config de Hyprland: allí la
            # sustitución ocurriría al cargar, fijando el monitor del arranque.
            hyprctl monitors -j 2>/dev/null |
                python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin) if m.get("focused")]' 2>/dev/null
            ;;
        *)
            printf '%s\n' "$MONITOR"
            ;;
    esac
}

# Una instancia por pantalla, aunque linux-wallpaperengine admita varias
# --screen-root a la vez: así cambiar una no obliga a relanzar la otra.
#
# El nombre del ejecutable supera los 15 caracteres que admite `pgrep -x`, así
# que buscamos por línea de comando. El wrapper de /usr/bin hace `cd /opt` y lo
# arranca como «./linux-wallpaperengine», de modo que una ruta absoluta sólo
# encontraría el wrapper y dejaría vivo el proceso que de verdad pinta.
pids_of() {
    pgrep -f "linux-wallpaperengine --screen-root $1 " 2>/dev/null || true
}

pids() {
    local mon
    for mon in $(monitors); do
        pids_of "$mon"
    done
}

running() {
    [[ -n "$(pids)" ]]
}

# Imprime "<id>\t<título>" por cada wallpaper de tipo scene.
scenes() {
    local d j
    for d in "$WORKSHOP"/*/; do
        j="$d/project.json"
        [[ -f "$j" ]] || continue
        python3 -c "
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit()
if data.get('type', '').lower() == 'scene':
    print(sys.argv[2] + '\t' + str(data.get('title', sys.argv[2])))
" "$j" "$(basename "$d")" 2>/dev/null
    done
}

stop_monitor() {
    local mon="$1" p
    p="$(pids_of "$mon")"

    if [[ -n "$p" ]]; then
        kill $p 2>/dev/null || true
        for _ in $(seq 20); do
            [[ -z "$(pids_of "$mon")" ]] && break
            sleep 0.1
        done
        [[ -n "$(pids_of "$mon")" ]] && kill -9 $(pids_of "$mon") 2>/dev/null || true
    fi
}

start() {
    local id="${1:-}" mon

    [[ -z "$id" ]] && id="$(scenes | shuf -n1 | cut -f1)"

    if [[ -z "$id" || ! -d "$WORKSHOP/$id" ]]; then
        printf 'No encuentro la scene %s en %s\n' "${id:-(ninguna)}" "$WORKSHOP" >&2
        exit 1
    fi

    local titulo
    titulo="$(scenes | grep "^${id}	" | cut -f2 || echo "$id")"

    for mon in $(monitors); do
        stop_monitor "$mon"
        # Un solo fondo animado por pantalla: si hay un vídeo ahí, lo quitamos.
        wallpaper-video stop --monitor "$mon" >/dev/null 2>&1 || true

        # setsid lo desacopla de este shell: si no, al salir el script el proceso
        # queda huérfano y recibe SIGHUP.
        setsid -f linux-wallpaperengine \
            --screen-root "$mon" --bg "$id" \
            --fps "$FPS" --silent --assets-dir "$ASSETS" \
            >/dev/null 2>&1

        printf 'Scene en %s: %s\n' "$mon" "$titulo"
    done
}

stop() {
    local mon
    for mon in $(monitors); do
        stop_monitor "$mon"
        printf 'Scene detenida en %s\n' "$mon"
    done
    awww restore 2>/dev/null || true
}

case "${1:-toggle}" in
    start)
        shift
        start "${1:-}"
        ;;
    stop) stop ;;
    next) start ;;
    list) scenes | sort -t$'\t' -k2 | column -t -s$'\t' ;;
    toggle)
        if running; then stop; else start; fi
        ;;
    *)
        printf 'Uso: %s [-m <monitor|all|focused>] {start|stop|toggle|next|list} [id]\n' "${0##*/}" >&2
        exit 1
        ;;
esac
